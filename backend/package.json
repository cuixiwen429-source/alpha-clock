{
  "name": "alpha-clock",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AlphaClock — 一条信息的价格，每秒都在掉。",
  "scripts": {
    "anvil": "anvil --block-time 1 --host 127.0.0.1 --port 8545",
    "deploy:local": "cd contracts && PATH=\"$HOME/.foundry/bin:$PATH\" forge script script/Deploy.s.sol:Deploy --rpc-url http://127.0.0.1:8545 --broadcast",
    "deploy:testnet": "cd contracts && PATH=\"$HOME/.foundry/bin:$PATH\" forge script script/Deploy.s.sol:Deploy --rpc-url https://testnet-rpc.monad.xyz --broadcast",
    "forge:build": "cd contracts && PATH=\"$HOME/.foundry/bin:$PATH\" forge build",
    "forge:test": "cd contracts && PATH=\"$HOME/.foundry/bin:$PATH\" forge test -vv",
    "seed": "tsx src/scripts/seed.ts",
    "buy": "tsx src/scripts/buy.ts",
    "serve": "tsx src/server/alpha-api.ts",
    "facilitator:local": "tsx src/server/local-facilitator.ts",
    "demo": "bash scripts/demo-local.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@x402/axios": "^2.28.0",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/express": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "ansi-colors": "^4.1.3",
    "dotenv": "^16.4.7",
    "ethers": "^6.17.0",
    "express": "^4.22.0",
    "viem": "^2.57.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
