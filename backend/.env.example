# ── 网络 ──────────────────────────────────────────────
# local-anvil | monad-testnet | monad-mainnet
NETWORK=local-anvil
MONAD_RPC_URL=http://127.0.0.1:8545

# ── 部署 ──────────────────────────────────────────────
# 部署者私钥（本地默认用 anvil 第一个账户）
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# x402 把成交写回链上的热钱包（不填 = 部署者）
VERIFIER_PRIVATE_KEY=
VERIFIER_ADDRESS=

# 平台金库（收 5% 抽成；不填 = 部署者）
TREASURY_ADDRESS=

# 已存在的 USDC（不填 = 本地部署 MockUSDC）
USDC_ADDRESS=

# ── API 服务 ──────────────────────────────────────────
PORT=4030

# 收据 HMAC 与本地审计日志使用；测试网/生产必须替换为随机强密钥
SERVER_SECRET=change-me-before-testnet

# 前端公开地址，用于 POST /api/signals 返回可分享链接
PUBLIC_APP_URL=http://127.0.0.1:5173

# deployments.json 没有 deploymentBlock 时可显式指定索引起点
DEPLOYMENT_BLOCK=

# 每 N 次实时价格响应，用合约 priceAt() 抽样核对 shared/curve.mjs
PRICE_CHECK_EVERY=20

# 留空 = 按网络自动判断（Monad 官方 facilitator 支持则开，本地则关）
X402_ENABLED=

FACILITATOR_URL=https://x402-facilitator.molandak.org

# 本地跑 x402 时用自建 facilitator
# USE_LOCAL_FACILITATOR=1
